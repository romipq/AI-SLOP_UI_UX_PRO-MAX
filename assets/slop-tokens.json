  "gradient": {
    "primary":  { "value": "linear-gradient(135deg, #7C3AED 0%, #4F46E5 45%, #EC4899 100%)", "type": "gradient" },
    "soft":     { "value": "linear-gradient(135deg, rgba(124,58,237,.22), rgba(79,70,229,.14) 45%, rgba(236,72,153,.18))", "type": "gradient" },
    "reverse":  { "value": "linear-gradient(315deg, #EC4899 0%, #4F46E5 55%, #7C3AED 100%)", "type": "gradient" },
    "text":     { "value": "linear-gradient(100deg, #A78BFA 0%, #F8FAFC 45%, #F472B6 100%)", "type": "gradient" },
    "border":   { "value": "linear-gradient(135deg, rgba(167,139,250,.9), rgba(236,72,153,.7) 55%, rgba(34,211,238,.6))", "type": "gradient" },
    "mesh": {
      "value": "radial-gradient(900px 600px at 12% -8%, rgba(124,58,237,.30), transparent 60%), radial-gradient(800px 520px at 92% 4%, rgba(236,72,153,.20), transparent 60%), radial-gradient(700px 500px at 50% 108%, rgba(34,211,238,.12), transparent 60%)",
      "type": "gradient"
    }
  },
  "shadow": {
    "glow-violet": { "value": "0 20px 60px -20px rgba(124,58,237,.65)", "type": "shadow" },
    "glow-pink":   { "value": "0 20px 60px -20px rgba(236,72,153,.55)", "type": "shadow" },
    "glow-cyan":   { "value": "0 20px 60px -20px rgba(34,211,238,.45)", "type": "shadow" },
    "card":        { "value": "inset 0 1px 0 rgba(255,255,255,.07), 0 24px 60px -40px #000", "type": "shadow" },
