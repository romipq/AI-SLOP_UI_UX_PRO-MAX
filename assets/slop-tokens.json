    "md":   { "value": "14px", "type": "dimension" },
    "card": { "value": "20px", "type": "dimension" },
    "lg":   { "value": "24px", "type": "dimension" },
    "xl":   { "value": "28px", "type": "dimension" },
    "pill": { "value": "999px", "type": "dimension" }
  },
  "space": {
    "section": { "value": "clamp(72px, 9vw, 128px)", "type": "dimension" },
    "block":   { "value": "clamp(40px, 5vw, 64px)", "type": "dimension" },
    "gap":     { "value": "24px", "type": "dimension" },
    "card":    { "value": "28px", "type": "dimension" }
  },
  "typography": {
    "font-sans": { "value": "'Inter', 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif", "type": "fontFamily" },
    "font-mono": { "value": "'JetBrains Mono', ui-monospace, monospace", "type": "fontFamily" },
    "display": { "value": { "fontSize": "clamp(40px, 6vw, 72px)", "fontWeight": 800, "letterSpacing": "-0.035em", "lineHeight": 1.03 }, "type": "typography" },
    "h2":      { "value": { "fontSize": "clamp(30px, 3.6vw, 46px)", "fontWeight": 700, "letterSpacing": "-0.03em", "lineHeight": 1.1 }, "type": "typography" },
    "h3":      { "value": { "fontSize": "24px", "fontWeight": 600, "letterSpacing": "-0.02em", "lineHeight": 1.25 }, "type": "typography" },
    "body":    { "value": { "fontSize": "16px", "fontWeight": 400, "lineHeight": 1.65 }, "type": "typography" },
    "micro":   { "value": { "fontSize": "12px", "fontWeight": 600, "letterSpacing": "0.12em", "lineHeight": 1.2 }, "type": "typography" }
  },
  "motion": {
    "ease-out":    { "value": "cubic-bezier(.22,1,.36,1)", "type": "cubicBezier" },
    "ease-spring": { "value": "cubic-bezier(.34,1.56,.64,1)", "type": "cubicBezier" },
    "dur-fast":    { "value": "160ms", "type": "duration" },
    "dur-base":    { "value": "250ms", "type": "duration" },
    "dur-slow":    { "value": "420ms", "type": "duration" }
  },
  "content": {
    "brandName": "Nebula",
    "eyebrow": "AI-Powered Workflows",
    "headline": "Ship {gradient} with AI-powered workflows",
