  },
  "bin": {
    "ai-slop-pro-max": "./bin/cli.mjs",
    "ai-slop": "./bin/cli.mjs"
  },
  "files": [
    "bin/",
    "skills/",
    "prompts/",
    "rules/",
    ".claude-plugin/",
    "skill.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "python3 -m unittest discover -s skills/ai-slop-ui-ux-pro-max/scripts/tests -v",
