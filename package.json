{
  "name": "ai-slop-ui-ux-pro-max",
  "version": "2.0.0",
  "description": "Deliberate AI-Slop UI/UX Design Intelligence: 5 Agent Skills, 286 searchable cliché records across 7 eras, Level 1-11 Slop Dials, Token Exporter, HTML/TSX Scaffolder, Slop Score™ Auditor, and Prompt Pack.",
  "type": "module",
  "license": "MIT",
  "author": "romipq",
  "repository": {
    "type": "git",
